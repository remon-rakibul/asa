# Postgres (shared by the agent data layer and the LangGraph checkpointer)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/appointments

# Ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3.5:9b
OLLAMA_TEMPERATURE=0.3

# LiveKit
LIVEKIT_URL=ws://localhost:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=devsecret

# TTS (voice worker). "parler" = natural Indic Parler-TTS (default),
# "mms" = faster but more robotic, "espeak" = robotic, no download.
TTS_ENGINE=parler
TTS_FAST_ENGINE=mms
TTS_QUALITY_TIMEOUT_SECONDS=6.0
# Optional: steer the Parler voice (gender/tone/pace). Empty = warm clinic default.
TTS_VOICE_DESCRIPTION=

# STT (faster-whisper)
WHISPER_MODEL=large-v3
STT_LANGUAGE=bn
WHISPER_DEVICE=cpu

# Clinic / doctor branding
CLINIC_NAME=My Clinic
DOCTOR_NAME=Dr. Smith
DOCTOR_PHONE=

# Twilio SMS (get these from console.twilio.com)
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_FROM_NUMBER=+1xxxxxxxxxx

# Admin API authentication (leave empty to disable in dev)
API_KEY=

# Booking behaviour
AVAILABILITY_DAYS_AHEAD=7
