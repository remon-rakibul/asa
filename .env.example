# Full reference of every setting in config.py. Only DATABASE_URL, JWT_SECRET,
# and PLATFORM_ADMIN_KEY are things you actually must change before running
# for real — everything else has a sane local-dev default. See README.md
# "Environment variables" for the human-readable version of this file, and
# docs/MONETIZATION.md / docs/WHATSAPP_AND_SMS.md / docs/TELEPHONY.md /
# docs/VOICE_WEB.md / docs/SCALING.md for the feature-level walkthroughs.

# ── Postgres (shared by the agent data layer and the LangGraph checkpointer) ──
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/appointments

# ── LLM provider ────────────────────────────────────────────────────────────
# "ollama" (local, default) | "gemini" (cloud). WARNING: gemini sends the full
# conversation, including patient PII, to Google.
LLM_PROVIDER=ollama

# ── Ollama (used when LLM_PROVIDER=ollama) ─────────────────────────────────
# OLLAMA_BASE_URL is what the app uses when run directly on the host.
OLLAMA_BASE_URL=http://localhost:11434
# DOCKER_OLLAMA_URL is what the *containers* use (see docker-compose.yml):
#   http://host.docker.internal:11434  -> reuse an Ollama running on the host
#                                          (the default; do NOT use --profile local-llm)
#   http://ollama:11434                -> use the containerized ollama service
#                                          (start with `docker compose --profile local-llm up`)
DOCKER_OLLAMA_URL=http://host.docker.internal:11434
OLLAMA_MODEL=gemma4:latest
OLLAMA_TEMPERATURE=0.3
# CPU threads for inference. 0 = let Ollama decide, but on hybrid Intel CPUs
# Ollama only counts performance cores, leaving other cores idle. Set to
# roughly (physical cores - 2) if inference feels slower than it should.
OLLAMA_NUM_THREAD=0
# Context window per request. Ollama's 4096 default silently truncates long
# conversations (system prompt + tools already ~1.5k tokens), breaking
# tool-calling. 8192 is the tested floor.
OLLAMA_NUM_CTX=8192
# Per-LLM-call timeout. Must survive the worst realistic case on a CPU-only
# box: cold model load + full prompt prefill on a long thread.
OLLAMA_TIMEOUT_SECONDS=720.0
OLLAMA_MAX_RETRIES=2
OLLAMA_MAX_CONCURRENT=4

# ── RAG (doctor/clinic knowledge base) ─────────────────────────────────────
EMBEDDING_MODEL=nomic-embed-text
EMBEDDING_DIMS=768
# "pgvector" (default; shared across workers, needs the pgvector extension —
# already in the postgres image) | "chroma" (legacy local files, single
# process only).
RAG_BACKEND=pgvector

# ── Gemini LLM (used when LLM_PROVIDER=gemini; reuses GEMINI_API_KEY below) ─
GEMINI_LLM_MODEL=gemini-2.5-flash
GEMINI_TEMPERATURE=0.3

# ── LiveKit (voice calls: browser + SIP telephony) ─────────────────────────
LIVEKIT_URL=ws://localhost:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=devsecret
# Must match the @server.rtc_session dispatch name in main.py.
LIVEKIT_AGENT_NAME=appointment-setter
# Apply LiveKit voice-isolation noise cancellation to call input (clearer STT
# in noisy clinics). Needs livekit-plugins-noise-cancellation and is a
# LiveKit Cloud feature with possible usage cost — off by default.
VOICE_NOISE_CANCELLATION=false
# CPU-utilisation (0-1) above which this voice worker stops accepting new
# calls. Default = never refuse: on a single-worker box there's no other
# replica to fall back to, and a finite threshold just hangs calls at
# "connecting" whenever the box is busy. Only set (e.g. 0.7) with multiple
# worker replicas behind LiveKit.
VOICE_LOAD_THRESHOLD=inf
# Scope for inbound voice calls that match no channels row — which includes
# every call to the platform's main number (per-caller dispatch rooms are
# named after the caller, not the dialed DID). "platform" (default) = the
# cross-hospital marketplace agent; "default_clinic" = legacy single-clinic
# fallback.
VOICE_FALLBACK_SCOPE=platform
# Gate platform-number calls to premium/trial patients matched by caller-ID
# against their one-time OTP-verified phone number. Others hear an
# LLM-composed decline + get an SMS upgrade link, then the call ends.
# Set false for local `main.py console` testing (no caller-ID there).
VOICE_PREMIUM_GATE=true

# ── LiveKit Inference voice (used when STT_ENGINE/TTS_ENGINE=livekit) ──────
# No separate provider keys — billed through your LiveKit Cloud account.
# WARNING: patient audio/text leave the box, same PII trade-off as other cloud engines.
LIVEKIT_STT_MODEL=speechmatics/enhanced
LIVEKIT_TTS_MODEL=cartesia/sonic-3
LIVEKIT_TTS_VOICE=

# ── TTS engine for the voice worker ─────────────────────────────────────────
# "mms"    -> facebook/mms-tts-ben, local neural VITS, fast enough on CPU (default)
# "gemini" -> Google Gemini cloud TTS, natural, auto-falls back to MMS on error/timeout
# "espeak" -> espeak-ng, robotic, zero download
# "parler" -> ai4bharat/indic-parler-tts, very natural but too slow to be usable on CPU
# "livekit"-> LiveKit Inference cloud TTS (see block above)
TTS_ENGINE=mms
TTS_FAST_ENGINE=mms
TTS_QUALITY_TIMEOUT_SECONDS=6.0
# Optional: steer the Parler voice (gender/tone/pace). Empty = warm clinic default.
TTS_VOICE_DESCRIPTION=
# Pitch shift in semitones applied to MMS-TTS output (negative = deeper voice,
# 0 = unchanged). Tempo is preserved.
TTS_PITCH_SEMITONES=0.0

# ── Gemini cloud TTS (used when TTS_ENGINE=gemini) ─────────────────────────
# WARNING: sends the agent's outgoing text (may contain patient PII) to Google.
GEMINI_API_KEY=
GEMINI_TTS_MODEL=gemini-2.5-flash-preview-tts
GEMINI_TTS_VOICE=Kore

# ── STT engine for the voice worker ─────────────────────────────────────────
# "whisper" -> local faster-whisper, no audio leaves the box (default)
# "gemini"  -> Google Gemini cloud STT (WARNING: sends patient audio to Google)
# "livekit" -> LiveKit Inference cloud STT (see block above)
STT_ENGINE=whisper
WHISPER_MODEL=medium
STT_LANGUAGE=bn
WHISPER_DEVICE=cpu
GEMINI_STT_MODEL=gemini-2.5-flash

# ── Clinic / doctor branding (fallbacks for unscoped/legacy sessions) ──────
CLINIC_NAME=My Clinic
DOCTOR_NAME=Dr. Smith
DOCTOR_PHONE=
# Marketplace brand the platform-wide assistant speaks for (portal home page
# chat/voice before a hospital is chosen). ASA = Appointment Setter Agent.
# The agent says this aloud on voice calls — a Bangla spelling (e.g. আসা)
# may TTS better than latin letters.
PLATFORM_NAME=ASA

# ── Authentication ──────────────────────────────────────────────────────────
# Legacy shared-secret admin API auth (leave empty to disable in dev).
API_KEY=
# JWT signing secret for staff/patient login — MUST be a strong random value
# in production (e.g. `openssl rand -hex 32`). The insecure default logs a
# warning on startup.
JWT_SECRET=dev-insecure-change-me
JWT_TTL_HOURS=12
# Required to create new hospital tenants via POST /clinics (platform-admin
# tooling, not the public /hospitals/signup flow). Generate a strong random
# string and keep it out of source control. Empty = tenant creation disabled.
PLATFORM_ADMIN_KEY=

# ── Booking behaviour ────────────────────────────────────────────────────────
AVAILABILITY_DAYS_AHEAD=7

# ── Payments & monetization (see docs/MONETIZATION.md) ─────────────────────
# manual = no gateway (auto-confirm or pay-at-desk); sslcommerz = BD sandbox/
# production gateway aggregating bKash/Nagad/cards — see
# docs/MONETIZATION.md#setting-up-sslcommerz-sandbox--production.
PAYMENT_PROVIDER=manual
PAYMENT_MANUAL_AUTOPAY=true          # set false in prod so bookings hold until marked paid
BOOKING_FEE_DEFAULT=0                # ৳ platform booking fee when a hospital sets none (0 = free)
PAYMENT_TTL_MINUTES=15               # how long a pending_payment slot hold survives
# Patient plans
PATIENT_SUBSCRIPTION_FEE=99          # ৳/month premium
PATIENT_TRIAL_DAYS=30
PATIENT_SUBSCRIPTION_DAYS=30         # premium horizon added per paid subscription period
FREE_AGENT_BOOKINGS_PER_MONTH=3
FREE_HISTORY_LIMIT=3
# Hospital plans
HOSPITAL_SUBSCRIPTION_FEE=999        # ৳/month
HOSPITAL_TRIAL_DAYS=30
HOSPITAL_BILLING_GRACE_DAYS=7
# SSLCommerz (only for PAYMENT_PROVIDER=sslcommerz)
SSLCOMMERZ_STORE_ID=
SSLCOMMERZ_STORE_PASSWD=
SSLCOMMERZ_SANDBOX=true
# Public URLs the gateway redirects/IPNs back to (must be internet-reachable in prod)
PUBLIC_BASE_URL=http://localhost:8000
PORTAL_BASE_URL=http://localhost:3000

# ── Resilience / observability ──────────────────────────────────────────────
LOG_LEVEL=INFO
LOG_JSON=false
SENTRY_DSN=
# Budget for the last-resort recovery reply composed after a turn already
# failed — kept short since the patient has already waited long enough.
RECOVERY_REPLY_TIMEOUT_SECONDS=90.0

# ── CORS (comma-separated origins allowed to call the API from a browser) ──
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ── Rate limiting (per-process; back with REDIS_URL for multi-worker) ──────
PATIENT_RATE_LIMIT_PER_MIN=60
ADMIN_LOGIN_RATE_LIMIT_PER_MIN=10    # brute-force protection on /auth/login
# Set true when running behind a reverse proxy / load balancer (production).
# Then the client IP for rate limiting + audit comes from X-Forwarded-For
# instead of the proxy's socket IP — without this, every request looks like it
# comes from the proxy and all clients share one rate-limit bucket (false 429s
# for everyone). Keep false on direct-to-internet deployments (the header is
# forgeable there).
TRUST_PROXY_HEADERS=false

# ── WhatsApp (Meta Cloud API — see docs/WHATSAPP_AND_SMS.md) ───────────────
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
WHATSAPP_VERIFY_TOKEN=
# App secret for webhook HMAC-SHA256 (X-Hub-Signature-256). Meta App
# Dashboard -> App Settings -> Basic -> App Secret.
WHATSAPP_APP_SECRET=

# ── SMS (see docs/WHATSAPP_AND_SMS.md) ──────────────────────────────────────
SMS_PROVIDER=twilio                  # "twilio" | "bdgateway" | "none"
# Twilio (get these from console.twilio.com)
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_FROM_NUMBER=+1xxxxxxxxxx
# bdgateway — a local BD HTTP SMS gateway (e.g. SSL Wireless); cheaper and
# supports Bangla Unicode + masked sender IDs. Field names vary by vendor —
# adjust tools/sms.py::_bdgateway_send to match your contract.
BD_SMS_API_URL=
BD_SMS_API_KEY=
BD_SMS_SENDER_ID=

# ── PII field-level encryption ──────────────────────────────────────────────
# Fernet symmetric key. Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Empty = no encryption (fine for local dev; MUST be set for a real hospital/
# bank deployment).
PATIENT_ENCRYPTION_KEY=

# ── HA / scalability (see docs/SCALING.md) ──────────────────────────────────
# Empty = in-process rate limiter (WEB_CONCURRENCY=1 only). Set to share rate
# limits across multiple backend workers/replicas.
REDIS_URL=
DB_POOL_MIN=2
DB_POOL_MAX=20

# ── Multi-tenant channel routing ────────────────────────────────────────────
# Reject inbound messages for unknown channel mappings instead of silently
# falling back to the default clinic. Recommended true for any multi-tenant
# (multi-hospital) deployment.
STRICT_CHANNEL_ROUTING=false

# ── HIS / EMR integration ───────────────────────────────────────────────────
HIS_WEBHOOK_SECRET=
