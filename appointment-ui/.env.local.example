# The Next.js app is fully API-driven — it never talks to Postgres directly,
# only to the FastAPI backend below. See ../ARCHITECTURE.md §3.

# Backend base URL. Baked in at build time (docker builds must set this to
# the PUBLIC backend URL before `next build` — see docs/DEPLOYMENT.md).
NEXT_PUBLIC_API_URL=http://localhost:8000

# Legacy shared-secret admin auth, only used by the standalone app/chat demo
# page. Leave empty unless the backend's API_KEY is also set.
NEXT_PUBLIC_API_KEY=
